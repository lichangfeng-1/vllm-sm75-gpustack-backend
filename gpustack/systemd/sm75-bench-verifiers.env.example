# Copy to /etc/sm75-bench-verifiers.env (0600, root).
# GPUSTACK_DATA_ROOT is the host directory mounted at /var/lib/gpustack
# in the model container; the launcher uses its benchlocal/ subdirectory.
GPUSTACK_DATA_ROOT=/data/gpustack-data-stage2
IMAGE=vllm-sm75-gpustack:v0.1.7-beta2-v7
BENCHLOCAL_NETWORK=sm75-bench-verifiers
SM75_CONSOLE_PORT=1615
