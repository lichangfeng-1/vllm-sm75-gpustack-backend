# 兼容件吸收薄层 (2026-11-16 用户令「不负面就吸、默认关、增兼容」):
#   final-v1 + vllm-Turing 0.32 兼容件 (NVFP4/Skillet/IDEC、EXL3、TurboQuant SM75、
#   UltraQuant 4bit KV、firefly fp8 AR 代码与 fail-closed 开关), 所有权能开关默认关。
#   不覆盖 final-v1 tag; 全关应与 final-v1 行为一致 (生产行26 显式 VLLM_FIREFLY_AR=0)。
# 构建上下文＝仓库根目录:
#   docker build -f gpustack/Dockerfile.compat-v1-20261116 \
#     -t vllm-sm75-gpustack:v0.1.7-beta2-v13-opt15-final-v1-compat1 .
ARG PARENT=vllm-sm75-gpustack:v0.1.7-beta2-v13-opt15-final-v1
FROM ${PARENT} AS parent

# 交付仓比 final-v1 领先 3 件 loader 改动 (2026-10-26 仓提交未烘入 final-v1 镜像)。
# 本兼容层只做「吸收 0.32 兼容件」: 这 3 件按父镜像原样回填 (父有则恢复、父无则删除),
# 不夹带漂移 (否则全关态与 final-v1 不等价; 是否单独吸收请主控另裁)。
RUN mkdir -p /opt/vllm-sm75/parent-loader && \
    for f in default_loader.py ep_weight_filter.py sm75_rank_shards.py; do \
        src=/usr/local/lib/python3.12/dist-packages/vllm/model_executor/model_loader/$f; \
        if [ -f "$src" ]; then cp "$src" /opt/vllm-sm75/parent-loader/; fi; \
    done

FROM ${PARENT}

LABEL org.sm75.compat="turing032-compat-default-off-20261116"

# 父镜像原样 loader 快照 (来自 parent 阶段, 用于抵消安装器对 3 件 loader 的覆盖)
COPY --from=parent /opt/vllm-sm75/parent-loader /opt/vllm-sm75/parent-loader

# vllm/ 整树进 /tmp/sm75-overlay: install_sm75_overlay.py 只按清单拷贝,
# 未入清单的文件(含历史 envs.py 参考副本)不会进镜像。
COPY vllm/ /tmp/sm75-overlay/
COPY docker/helpers/install_sm75_overlay.py /tmp/install_sm75_overlay.py
COPY docker/helpers/patch_request_usage.py /tmp/patch_request_usage.py
COPY docker/helpers/install_speculative.py /tmp/install_speculative.py
COPY docker/helpers/verify_compat_switches.py /tmp/verify_compat_switches.py
COPY docker/speculative /opt/vllm-sm75/speculative

RUN python3 /tmp/install_sm75_overlay.py /tmp/sm75-overlay && \
    python3 /tmp/install_speculative.py && \
    python3 /tmp/verify_compat_switches.py && \
    DST=/usr/local/lib/python3.12/dist-packages/vllm/model_executor/model_loader && \
    for f in default_loader.py ep_weight_filter.py sm75_rank_shards.py; do \
        if [ -f /opt/vllm-sm75/parent-loader/$f ]; then \
            cp /opt/vllm-sm75/parent-loader/$f "$DST/$f"; \
        else \
            rm -f "$DST/$f"; \
        fi; \
    done && \
    rm -rf /tmp/sm75-overlay /tmp/install_sm75_overlay.py \
        /tmp/patch_request_usage.py /tmp/install_speculative.py \
        /tmp/verify_compat_switches.py

# 产物自证: 兼容件在镜像内的哈希清单 (证据件, 不参与开关逻辑)。
RUN cd /usr/local/lib/python3.12/dist-packages/vllm && \
    sha256sum \
      model_executor/kernels/linear/nvfp4/marlin.py \
      model_executor/layers/quantization/utils/firefly_nvfp4.py \
      model_executor/layers/quantization/utils/firefly_skillet.py \
      model_executor/layers/quantization/utils/firefly_idecode.py \
      model_executor/layers/quantization/exl3/exl3.py \
      v1/attention/backends/turboquant_attn.py \
      v1/attention/backends/ultraquant_attn.py \
      v1/kv_cache_interface.py \
      envs_sm75.py \
      distributed/device_communicators/firefly_allreduce.py \
    > /opt/vllm-sm75/evidence/compat-files.sha256 && \
    cat /opt/vllm-sm75/evidence/compat-files.sha256