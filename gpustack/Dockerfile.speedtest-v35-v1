ARG PARENT=vllm-sm75-gpustack:v0.1.7-beta2-v13-opt15
FROM ${PARENT}
ARG SPEEDTEST_COMMIT=07895cffd90bb9ff4847695ed7f90d097832518c
LABEL org.sm75.speedtest.upstream="${SPEEDTEST_COMMIT}"
COPY LLM_Speed_Test_v3_Python_Backend.html /opt/sm75-workbench/extensions/speedtest/LLM_Speed_Test_v3_Python_Backend.html
COPY LLM_Speed_Test_v3_Leaderboard.html /opt/sm75-workbench/extensions/speedtest/LLM_Speed_Test_v3_Leaderboard.html
COPY llm_test_backend.py /opt/sm75-workbench/extensions/speedtest/llm_test_backend.py
