--- a/docker/Dockerfile
+++ b/docker/Dockerfile
@@ -3,16 +3,30 @@
 ARG BASE_IMAGE=vllm/vllm-openai:v0.30.0-cu129@sha256:58fdb6bb123a81aa53f46fa4652ad8cc87e817bd1077c9832c6258ef12c1c688
 
 FROM ${BASE_IMAGE} AS sm75-base
-RUN uv pip uninstall --system flashinfer-jit-cache && \
-    uv pip install --system --no-cache --no-deps flashinfer-python==0.6.18 flashinfer-cubin==0.6.18 \
-        --extra-index-url https://flashinfer.ai/whl/
+
+# 国内源改动 d)：构建期 pypi 索引整体切到国内镜像。
+# UV_DEFAULT_INDEX 是 uv 的官方环境变量，仅影响本镜像构建期解析；
+# ENV 会随层继承到运行期，但运行期不跑 pip/uv 安装，故不重置（如需干净运行期在 final 前 unset）。
+ARG PIP_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple
+ENV UV_DEFAULT_INDEX=${PIP_MIRROR}
+
+# 国内源改动 b)：flashinfer 两个包拆成两条安装。
+# flashinfer-python 由上面的国内 pypi 镜像解析；flashinfer-cubin 清华镜像上只到 0.5.x、没有 0.6.18，
+# 故钉上游 GitHub Release 直链＋URL 片段里的 sha256（本仓不托管、不重新分发；上游挪址或换字节都会红）。
+RUN uv pip uninstall --system flashinfer-jit-cache
+RUN uv pip install --system --no-cache --no-deps flashinfer-python==0.6.18
+RUN uv pip install --system --no-cache --no-deps \
+        "https://github.com/flashinfer-ai/flashinfer/releases/download/v0.6.18/flashinfer_cubin-0.6.18-py3-none-any.whl#sha256=2dd65c0fcfc6bc44c67f148530de5372979c2e3d260e47935730f94156d4d873"
 
 # The pinned official cu129 image contains Torch 2.14/cu130 after its optional
 # connector install, while its vLLM/torchvision wheels require Torch 2.13.
 # Restore the CUDA 12.9 ABI before compiling any extension; keep the official
 # /etc/uv-overrides.txt NCCL pin. Resolve exact CUDA wheel and Triton versions.
+# 国内源改动 a)：PyTorch cu129 轮子索引参数化，默认值为 preflight 实测可探活的国内镜像。
+# 覆盖方式：docker build --build-arg PYTORCH_MIRROR=<url>
+ARG PYTORCH_MIRROR=https://mirror.sjtu.edu.cn/pytorch-wheels/cu129
 RUN uv pip install --system --no-cache \
-        --index https://download.pytorch.org/whl/cu129 \
+        --index ${PYTORCH_MIRROR} \
         torch==2.13.0+cu129 triton==3.7.1 && \
     python3 -c 'import torch, importlib.metadata as m; assert torch.__version__ == "2.13.0+cu129"; assert torch.version.cuda == "12.9"; assert m.version("triton") == "3.7.1"'
 
